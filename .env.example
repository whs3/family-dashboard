# Copy this file to .env and fill in your values.
# See README.md for how to create Google OAuth credentials.

PORT=3000

# The base URL other devices on your home network will use to reach this
# server. Used to build the Google OAuth redirect URI. Use the host
# machine's LAN IP or hostname, e.g. http://192.168.1.50:3000
BASE_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
